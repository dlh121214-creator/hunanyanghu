{
  "openapi": "3.1.0",
  "info": {
    "title": "湖南养护工程施工交底参考系统智能体服务",
    "description": "工程类型识别、候选确认、知识检索、多工程整理和问题上报接口。所有业务接口统一位于 /api/v1。",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "系统"
        ],
        "summary": "服务健康检查",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/system/capabilities": {
      "get": {
        "tags": [
          "系统"
        ],
        "summary": "获取当前服务能力和开关",
        "description": "返回可公开的运行配置，不返回API密钥和内部地址。",
        "operationId": "get_capabilities_api_v1_system_capabilities_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CapabilitiesResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/intent/match": {
      "post": {
        "tags": [
          "意图识别"
        ],
        "summary": "识别工程并返回标准标签候选",
        "description": "调用8B判断模型识别单个或多个工程，再通过关键词匹配为每个工程返回匹配度最高的标准工程标签。匹配度由关键词规则产生，不是模型置信度。",
        "operationId": "match_intent_api_v1_intent_match_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IntentMatchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IntentMatchResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/intent/confirm": {
      "post": {
        "tags": [
          "意图识别"
        ],
        "summary": "确认工程类型候选",
        "description": "员工必须为每个工程分组选择一个候选标准标签，或明确选择网络搜索兜底。不能提交候选列表之外的标准标签。",
        "operationId": "confirm_intent_api_v1_intent_confirm_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IntentConfirmRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IntentConfirmResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/issues/report": {
      "post": {
        "tags": [
          "问题上报"
        ],
        "summary": "上报缺失工程类型",
        "description": "记录员工提交的缺失工程类型，供后续业务人员处理。",
        "operationId": "report_issue_api_v1_issues_report_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IssueReportRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IssueReportResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/knowledge/retrieve": {
      "post": {
        "tags": [
          "知识检索"
        ],
        "summary": "检索已确认工程的养护内容",
        "description": "根据当前请求中员工已确认的工程类型查询知识内容。当前开发阶段使用Mock提供者；单工程返回direct，多工程返回compose。无本地内容时标记为需要网络兜底。",
        "operationId": "retrieve_knowledge_api_v1_knowledge_retrieve_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/KnowledgeRetrieveRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KnowledgeRetrieveResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/output/compose": {
      "post": {
        "tags": [
          "内容输出"
        ],
        "summary": "整理多个工程的综合内容",
        "description": "读取当前请求最近一次知识检索结果。只有至少两项有效工程内容时调用8B模型；结果未通过工程类型、来源及受保护内容校验时，自动降级为分工程展示。",
        "operationId": "compose_output_api_v1_output_compose_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ComposeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ComposeResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
